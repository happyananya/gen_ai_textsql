# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use a READ-ONLY role for the assistant (see db/readonly_role.sql).
DATABASE_URL=postgresql://sda_readonly:password@db.<project-ref>.supabase.co:5432/postgres

# Admin connection used only by db/seed.py to create tables and load data.
DATABASE_ADMIN_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres

# LLM
ANTHROPIC_API_KEY=
SDA_MODEL=claude-opus-5-5
SDA_EFFORT=medium

# Pipeline
SDA_PIPELINE=baseline          # baseline | rag
SDA_RAG_TOP_K=4
SDA_RAG_RETRIEVER=lexical      # lexical | embedding
SDA_RAG_REPR=described         # name | columns | described | samples
SDA_RAG_GRANULARITY=table      # table | column
SDA_RAG_EXPANSION=joinpath     # none | fk1 | joinpath
SDA_MAX_RETRIES=2              # self-correction attempts after a failed SQL execution
SDA_ROW_LIMIT=500
SDA_STATEMENT_TIMEOUT_MS=10000
SDA_TRACE_DIR=traces
